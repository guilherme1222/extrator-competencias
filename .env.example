# Banco de produção/desenvolvimento
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/competencias

# Banco usado pelos testes de merge. Precisa ser um banco descartável:
# os testes rodam TRUNCATE pessoa CASCADE. Sem esta variável, os testes
# de banco são pulados (os de extração rodam de qualquer forma).
DATABASE_URL_TESTE=postgresql://postgres:postgres@localhost:5432/competencias_teste
